# 🔐 Event Planner - Auth Service Environment Configuration
# 
# 📋 GUIDE D'UTILISATION :
# 1. Copier ce fichier en .env.local pour le développement
# 2. Copier ce fichier en .env pour la production
# 3. Remplacer les valeurs par défaut par vos vraies clés
# 4. NE JAMAIS COMMITTER le fichier .env contenant des secrets !

# ===========================================
# 🚀 SERVEUR & ENVIRONNEMENT
# ===========================================
PORT=3000
# 🎯 Port d'écoute du service (doit être unique par service)
NODE_ENV=development
# 🌍 Environnement : development | staging | production

# URL du frontend (pour les liens dans les emails et l'origine OAuth web)
# Adapter a votre vrai host frontend. Exemple local courant: http://localhost:3006
FRONTEND_URL=http://localhost:3006
# 🔗 URL de l'application frontend utilisee par les liens, redirections et callbacks OAuth web

# ===========================================
# 🗄️ BASE DE DONNÉES POSTGRESQL
# ===========================================
DB_HOST=localhost
# 🏠 Hôte de la base de données (localhost en dev, RDS endpoint en prod)
DB_PORT=5432
# 🚪 Port PostgreSQL (5432 par défaut)
DB_NAME=event_planner_auth
# 📊 Nom de la base de données (préfixe event_planner_ recommandé)
DB_USER=postgres
# 👤 Utilisateur PostgreSQL (créer un utilisateur dédié en prod)
DB_PASSWORD=postgres
# 🔐 Mot de passe PostgreSQL (utiliser un mot de passe fort en prod)
DB_SSL=false
# 🔒 Connexion SSL (true en production avec RDS)

# Bootstrap automatique de la base de données
# ⚠️  DÉSACTIVÉ PAR DÉFAUT EN PRODUCTION POUR SÉCURITÉ
# ✅ true : Crée automatiquement les tables et index au démarrage
# ❌ false : Nécessite une migration manuelle en production
DB_AUTO_BOOTSTRAP=false

# ===========================================
# 🔐 JWT & AUTHENTIFICATION
# ===========================================
# ⚠️ IMPORTANT: Utiliser le même secret dans tous les services
# 🔑 Générer une clé sécurisée : openssl rand -base64 32
JWT_SECRET=your_super_secure_256_bit_secret_key_change_in_production
# 🔐 Clé secrète pour signer les tokens JWT (256 bits minimum)

# ⏰ Durée de validité des tokens
JWT_EXPIRES_IN=15m
AUTH_MOCKS=true
OAUTH_MOCK=true
GOOGLE_OAUTH_MOCK=
APPLE_OAUTH_MOCK=
# ⏱️ Durée du token d'accès (court pour la sécurité)
JWT_REFRESH_EXPIRES_IN=7d
# 🔄 Durée du token de rafraîchissement (plus long pour l'UX)

# 🔧 Configuration JWT avancée
JWT_ALGORITHM=HS256
# 🛠️ Algorithme de signature (HS256 ou RS256)
JWT_ISSUER=auth-service
# 🏢 Émetteur du token (nom du service)
JWT_AUDIENCE=event-planner
# 👥 Audience du token (nom de l'application)

# Configuration validation JWT
JWT_VERIFY_ISSUER=true
# ✅ Vérifier l'émetteur du token (sécurité)
JWT_VERIFY_AUDIENCE=true
# ✅ Vérifier l'audience du token (sécurité)
JWT_VERIFY_EXPIRATION=true
# ✅ Vérifier l'expiration du token (sécurité)
JWT_MAX_AGE=7d
# 📅 Âge maximum du token accepté
JWT_CLOCK_TOLERANCE=0
# ⏰ Tolérance de temps (pour les décalages d'horloge)

# ===========================================
# 🛡️ SÉCURITÉ
# ===========================================
BCRYPT_ROUNDS=12
# 🔢 Nombre de rounds pour le hashage des mots de passe (12 recommandé)
CORS_ORIGIN=http://localhost:3000,http://localhost:3006
# 🌐 Origines autorisées pour CORS (séparer par des virgules)

# ===========================================
# 📧 EMAIL SERVICE (SMTP PRIMAIRE)
# ===========================================
SMTP_HOST=smtp.gmail.com
# 📧 Serveur SMTP principal
SMTP_PORT=587
# 🚪 Port SMTP (587 pour TLS, 465 pour SSL)
SMTP_SECURE=false
# 🔒 Connexion sécurisée (false pour TLS, true pour SSL)
SMTP_USER=your_email@gmail.com
# 👤 Email SMTP (utiliser un email dédié en prod)
SMTP_PASS=your_app_password
# 🔐 Mot de passe SMTP (utiliser un mot d'application Gmail)

# ===========================================
# 📧 SENDGRID (FALLBACK EMAIL)
# ===========================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
# 🔑 Clé API SendGrid (backup si SMTP échoue)
FROM_EMAIL=noreply@eventplanner.com
# 📧 Email d'expéditeur (doit être vérifié chez SendGrid)
FROM_NAME=Event Planner
# 📝 Nom d'expéditeur affiché

# ===========================================
# 📱 SMS SERVICE (TWILIO PRIMAIRE)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
# 🔑 SID du compte Twilio (obtenir depuis console.twilio.com)
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# 🔐 Token d'authentification Twilio
TWILIO_PHONE_NUMBER=+1234567890
# 📱 Numéro Twilio (format international avec +)

# ===========================================
# 📱 VONAGE (FALLBACK SMS)
# ===========================================
VONAGE_API_KEY=your_vonage_api_key
# 🔑 Clé API Vonage (backup si Twilio échoue)
VONAGE_API_SECRET=your_vonage_api_secret
# 🔐 Secret API Vonage
VONAGE_FROM_NUMBER=EventPlanner
# 📝 Nom d'expéditeur Vonage

# ===========================================
# 💾 CACHE REDIS
# ===========================================
REDIS_HOST=localhost
# 🏠 Hôte Redis (localhost en dev, ElastiCache endpoint en prod)
REDIS_PORT=6379
# 🚪 Port Redis (6379 par défaut)
REDIS_PASSWORD=your_redis_password
# 🔐 Mot de passe Redis (recommandé en production)
REDIS_DB=0
# 📊 Numéro de la base Redis (0-15)

# ===========================================
# 🔢 OTP (ONE-TIME PASSWORD)
# ===========================================
OTP_LENGTH=6
# 🔢 Longueur du code OTP (6 chiffres recommandé)
OTP_EXPIRES_IN=300
# ⏰ Durée de validité de l'OTP en secondes (300 = 5 minutes)

# ===========================================
# 📝 LOGGING
# ===========================================
LOG_LEVEL=info
# 📊 Niveau de log : error | warn | info | debug
LOG_FILE_PATH=logs
# 📁 Chemin des fichiers de log
LOG_MAX_SIZE=20MB
# 📏 Taille maximale d'un fichier de log
LOG_MAX_FILES=14d
# 📅 Durée de rétention des logs (14 jours recommandé)

# ===========================================
# 📊 MONITORING
# ===========================================
ENABLE_METRICS=true
# 📈 Activer les métriques Prometheus
METRICS_PORT=9090
# 🚪 Port pour les métriques (doit être unique)

# ===========================================
# 🚦 RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
# ⏰ Fenêtre de temps pour le rate limiting (900000ms = 15 minutes)
RATE_LIMIT_MAX_REQUESTS=100
# 🔢 Nombre max de requêtes par fenêtre (global)
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# 🔢 Nombre max de tentatives d'auth par fenêtre (plus strict)

# ===========================================
# 🔑 OAUTH - GOOGLE SIGN-IN
# ===========================================
# Obtenir depuis: https://console.cloud.google.com/apis/credentials
# 📋 Étapes reelles pour cette plateforme :
# 1. Créer un projet Google Cloud
# 2. Configurer l'écran de consentement OAuth
# 3. Créer un "OAuth client ID" de type "Web application"
# 4. Ajouter les "Authorized JavaScript origins" du frontend
#    - local: http://localhost:3006 (ou votre vrai port)
#    - production: https://votre-domaine-frontend
# 5. Copier le Client ID et le Client Secret ici
# Note: le frontend utilise Google Identity Services et envoie un ID token au backend.
# Le callback /auth/google/callback n'est pas le flux principal utilise par l'UI actuelle.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# 🔑 ID client Google OAuth
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 🔐 Secret client Google OAuth

# ===========================================
# 🔑 OAUTH - APPLE SIGN-IN
# ===========================================
# Obtenir depuis: https://developer.apple.com/account/resources/identifiers/list
# 📋 Étapes reelles pour cette plateforme :
# 1. Activer "Sign in with Apple" sur votre App ID / votre projet Apple
# 2. Créer un "Services ID" pour le web
# 3. Configurer le domaine web et les Return URLs du frontend
#    - la plateforme initialise Apple JS avec redirectURI = window.location.origin
#    - utilisez donc l'origine frontend exacte, ex: https://votre-domaine-frontend
# 4. Créer une clé "Sign in with Apple" et télécharger le fichier .p8
# 5. Reporter ici le Services ID, Team ID, Key ID et le contenu de la clé privée
# Note: pour Apple web, privilégiez un domaine HTTPS réel ou un tunnel HTTPS en dev.
APPLE_CLIENT_ID=com.yourapp.service
# 🔑 ID client Apple OAuth
APPLE_TEAM_ID=your_apple_team_id
# 🏢 ID équipe Apple Developer
APPLE_KEY_ID=your_apple_key_id
# 🔑 ID de la clé privée Apple
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----"
# 🔐 Clé privée Apple (format PEM)

# ===========================================
# 🔑 OAUTH - SÉCURITÉ
# ===========================================
OAUTH_TOKEN_EXPIRES_IN=10m
# ⏰ Durée du token OAuth
OAUTH_STATE_EXPIRES_IN=5m
# 🔄 Durée du state OAuth (CSRF protection)
OAUTH_NONCE_EXPIRES_IN=5m
# 🔢 Durée du nonce OAuth (replay attack protection)

# ===========================================
# 🌐 INTER-SERVICES COMMUNICATION
# ===========================================
# Token partagé pour communication entre services
# 🔑 Générer : openssl rand -base64 32
SHARED_SERVICE_TOKEN=shared-service-token-abcdef12345678901234567890
# 🔐 Token pour authentifier les communications inter-services

# URLs des autres services (pour health checks et communication)
CORE_SERVICE_URL=http://localhost:3001
# 🎯 URL du Core Service
NOTIFICATION_SERVICE_URL=http://localhost:3002
# 📧 URL du Notification Service
PAYMENT_SERVICE_URL=http://localhost:3003
# 💳 URL du Payment Service
TICKET_GENERATOR_SERVICE_URL=http://localhost:3004
# 🎫 URL du Ticket Generator Service
SCAN_VALIDATION_SERVICE_URL=http://localhost:3005
# 🔍 URL du Scan Validation Service
